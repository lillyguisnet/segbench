# secrets
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc

# model weights (SAM, DINOv3, local LLMs) are downloaded, never committed
weights/
*.pt
*.pth
*.safetensors

# third-party research code cloned at a pinned commit (see each pyproject.toml)
specialists/*/vendor/
.thumbs/

# canonical PNGs for the annotation app are rebuilt by scripts/prepare_annotation_set.py
annotations/data/*/canonical/
annotations/backup/
annotations/backup-history/
annotations/exports/

# charts drawn from made-up data (scripts/draw_charts.py --demo)
charts/demo/

# answer viewers, rebuilt by scripts/view_run.py
results/views/

# a new model's scores before publishing, rebuilt by scripts/add_model.py preview
results/preview/

# Review app assets, rebuilt by scripts/build_consensus_review.py
apps/consensus-review/images/
apps/consensus-review/seed.js

# Duplicate photos in generated point benchmark reports (originals are in images/)
results/point-benchmark-*/images/

# Screen review app: private screenshots and built seed, rebuilt by scripts/build_screen_review.py
apps/screen-key-review/images/
apps/screen-key-review/seed.js

# trial reports: duplicate photos (originals in images/) and drawings on the private screenshots
results/*-trial/*/images/
results/*-trial/screens*/*.png
apps/box-review/images/
apps/box-review/seed.js
apps/measure-clicks/images/
apps/measure-clicks/seed.js
annotations/measure/history/

# Third-party PixMo evaluation images, masks and downloaded source files
cache/pixmo-points-eval/

# run logs stay on the machine (the ones already in the repo were added before this rule)
*.log

# local caches of model replies and judge runs
cache/

# YOLOE text-encoder file (243 MB, over GitHub's file limit); Ultralytics downloads it on first run
specialists/yoloe/mobileclip2_b.ts

# first thinking-levels run (51 MB), not read by scripts/build_thinking_levels.py; kept on lambda only
results/run-thinking-levels-v1.jsonl

# duplicate photos in the thinking-levels report (originals are in images/)
results/thinking-levels-*/images/
