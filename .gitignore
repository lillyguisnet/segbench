# secrets
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc

# model weights (SAM, DINOv3, local LLMs) are downloaded, never committed
weights/
*.pt
*.pth
*.safetensors

# third-party research code cloned at a pinned commit (see each pyproject.toml)
specialists/*/vendor/
.thumbs/

# canonical PNGs for the annotation app are rebuilt by scripts/prepare_annotation_set.py
annotations/data/*/canonical/
annotations/backup/
annotations/backup-history/
annotations/exports/

# charts drawn from made-up data (scripts/draw_charts.py --demo)
charts/demo/

# answer viewers, rebuilt by scripts/view_run.py
results/views/

# Review app assets, rebuilt by scripts/build_consensus_review.py
apps/consensus-review/images/
apps/consensus-review/seed.js

# Duplicate photos in generated point benchmark reports (originals are in images/)
results/point-benchmark-*/images/
